<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.jvoice-project</groupId>
  <artifactId>micro-wakeword4j-wasm</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>micro-wakeword4j-wasm</name>
  <description>micro-wakeword4j compiled to WebAssembly with TeaVM, for wake word detection in browsers</description>
  <url>https://github.com/jvoice-project/micro-wakeword4j-wasm</url>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>digitaldan</id>
      <name>Dan Cunningham</name>
      <email>dan@digitaldan.com</email>
      <organizationUrl>https://github.com/digitaldan</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/jvoice-project/micro-wakeword4j-wasm.git</connection>
    <developerConnection>scm:git:git://github.com/jvoice-project/micro-wakeword4j-wasm.git</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/jvoice-project/micro-wakeword4j-wasm</url>
  </scm>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <micro-wakeword4j.version>1.0.0</micro-wakeword4j.version>
    <teavm.version>0.16.0</teavm.version>
    <dist.directory>${project.build.directory}/dist</dist.directory>
    <library.directory>${project.build.directory}/micro-wakeword4j</library.directory>
    <maven.test.skip>false</maven.test.skip>
    <!-- so that either property skips the check of the WebAssembly build -->
    <skipTests>${maven.test.skip}</skipTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.jvoice-project</groupId>
      <artifactId>micro-wakeword4j</artifactId>
      <version>${micro-wakeword4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Enforcer Plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce-java</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>${java.version}</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>3.9.0</version>
                </requireMavenVersion>
              </rules>
              <failFast>true</failFast>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Clean Plugin to delete the unpacked library, so that files removed from the library don't stay behind -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>clean-library</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>initialize</phase>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${library.directory}</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Dependency Plugin to unpack what the build and its tests take from other artifacts -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.9.0</version>
        <executions>
          <!-- the built-in models and licenses of the library, and the models, audio and reference data of its tests -->
          <execution>
            <id>unpack-library</id>
            <goals>
              <goal>unpack</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <outputDirectory>${library.directory}</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>io.github.jvoice-project</groupId>
                  <artifactId>micro-wakeword4j</artifactId>
                  <version>${micro-wakeword4j.version}</version>
                  <overWrite>true</overWrite>
                  <excludes>**/*.class</excludes>
                </artifactItem>
                <artifactItem>
                  <groupId>io.github.jvoice-project</groupId>
                  <artifactId>micro-wakeword4j</artifactId>
                  <version>${micro-wakeword4j.version}</version>
                  <classifier>tests</classifier>
                  <overWrite>true</overWrite>
                  <includes>audio/**,models/**,reference/**</includes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <!-- the JavaScript loader that instantiates the module -->
          <execution>
            <id>copy-teavm-runtime</id>
            <goals>
              <goal>unpack</goal>
            </goals>
            <phase>prepare-package</phase>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.teavm</groupId>
                  <artifactId>teavm-core</artifactId>
                  <version>${teavm.version}</version>
                  <!-- unpacked every time, so that the loader comes back when the dist directory was deleted -->
                  <overWrite>true</overWrite>
                  <includes>org/teavm/backend/wasm/wasm-gc-module-runtime.min.js</includes>
                  <outputDirectory>${dist.directory}</outputDirectory>
                  <fileMappers>
                    <org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                      <pattern>^.*$</pattern>
                      <replacement>teavm-runtime.js</replacement>
                    </org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                  </fileMappers>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- TeaVM Plugin to compile the library to WebAssembly -->
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <id>compile-wasm</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <phase>prepare-package</phase>
            <configuration>
              <targetType>WEBASSEMBLY_GC</targetType>
              <mainClass>io.github.jvoiceproject.microwakeword.wasm.WasmModule</mainClass>
              <targetDirectory>${dist.directory}</targetDirectory>
              <targetFileName>micro-wakeword.wasm</targetFileName>
              <optimizationLevel>FULL</optimizationLevel>
              <minifying>true</minifying>
              <debugInformationGenerated>false</debugInformationGenerated>
              <!-- not strict: in TeaVM 0.16 a strict module keeps the JavaScript thread busy for minutes after it loads -->
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Resources Plugin to put the JavaScript module, its metadata and licenses next to the WebAssembly -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-dist</id>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <phase>prepare-package</phase>
            <configuration>
              <outputDirectory>${dist.directory}</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/js</directory>
                  <filtering>true</filtering>
                  <includes>
                    <include>package.json</include>
                  </includes>
                </resource>
                <resource>
                  <directory>src/main/js</directory>
                  <excludes>
                    <exclude>package.json</exclude>
                  </excludes>
                </resource>
                <resource>
                  <directory>${project.basedir}</directory>
                  <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                    <include>README.md</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${library.directory}/io/github/jvoiceproject/microwakeword/internal/tflite/frontend</directory>
                  <includes>
                    <include>LICENSE-kissfft</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Exec Plugin to run the reference tests of micro-wakeword4j against the WebAssembly build -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>check-wasm</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>integration-test</phase>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>node</executable>
              <arguments>
                <!-- Node.js 22 and 24 need this for the exception instructions that TeaVM emits -->
                <argument>--experimental-wasm-exnref</argument>
                <argument>src/test/js/check.mjs</argument>
                <argument>${dist.directory}</argument>
                <argument>${library.directory}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Release Plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-release-plugin</artifactId>
        <version>3.3.1</version>
        <configuration>
          <pushChanges>false</pushChanges>
          <tagNameFormat>v@{project.version}</tagNameFormat>
          <preparationGoals>clean spotless:apply verify</preparationGoals>
          <completionGoals>spotless:apply</completionGoals>
        </configuration>
      </plugin>
      <!-- Spotless Plugin -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.4</version>
        <configuration>
          <formats>
            <format>
              <includes>
                <include>.gitattributes</include>
                <include>.gitignore</include>
              </includes>
              <trimTrailingWhitespace/>
              <endWithNewline/>
              <indent>
                <tabs>true</tabs>
                <spacesPerTab>4</spacesPerTab>
              </indent>
            </format>
          </formats>
          <java>
            <googleJavaFormat>
              <version>1.25.2</version>
              <style>AOSP</style>
              <reflowLongStrings>true</reflowLongStrings>
              <formatJavadoc>true</formatJavadoc>
            </googleJavaFormat>

            <importOrder>
              <wildcardsLast>true</wildcardsLast>
              <order>\#io.github.jvoiceproject,io.github.jvoiceproject,java|javax|jakarta,\#</order>
              <!-- you can use an empty string for all the imports you didn't specify explicitly, '|' to join group without blank line, and '\#` prefix for static imports. -->
            </importOrder>
          </java>

          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
              <indentAttribute>schemaLocation</indentAttribute>
              <predefinedSortOrder>recommended_2008_06</predefinedSortOrder>
              <sortDependencyExclusions/>
              <sortDependencyManagement/>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
      <!-- License Plugin -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.7.1</version>
        <configuration>
          <inceptionYear>2026</inceptionYear>
          <licenseName>apache_v2</licenseName>
          <organizationName>jvoice-project</organizationName>
          <projectName>micro-wakeword4j-wasm</projectName>
          <copyrightOwners>Contributors to micro-wakeword4j-wasm</copyrightOwners>
          <addJavaLicenseAfterPackage>false</addJavaLicenseAfterPackage>
          <useJavaNoReformatCommentStartTag>false</useJavaNoReformatCommentStartTag>
          <trimHeaderLine>true</trimHeaderLine>
          <failOnMissingHeader>true</failOnMissingHeader>
          <failOnNotUptodateHeader>true</failOnNotUptodateHeader>

          <roots>
            <root>src/main/java</root>
          </roots>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check-file-header</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
